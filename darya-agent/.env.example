# ==============================================
# DARYA DESIGN WIZARD - ENVIRONMENT CONFIGURATION
# ==============================================

# API Keys & Credentials
# =====================

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-v0-xxxxxxxxxxxxx

# Google APIs
GOOGLE_TRENDS_API_KEY=xxxxxxxxxxxxxxxxx
GOOGLE_ANALYTICS_PROPERTY_ID=G-XXXXXXXXXX
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-XXXXXXXXXX

# Figma Integration (optional)
FIGMA_API_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Integration
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Services
# ========

# Superdesign Integration
SUPERDESIGN_API_URL=http://localhost:3001
SUPERDESIGN_API_KEY=xxx

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/darya_db
REDIS_URL=redis://localhost:6379

# Servers & URLs
SERVER_PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Configuration
# =============

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Language Support
BILINGUAL_ENABLED=true
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es

# Features
GOOGLE_TRENDS_ENABLED=true
VR_XR_ENABLED=true
HOLOGRAM_EFFECTS_ENABLED=true
REAL_TIME_MONITORING=true

# Model Configuration
LLM_MODEL=claude-opus-4-5
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Kupuri Agency Configuration
AGENCY_NAME=Kupuri
AGENCY_ID=kupuri-001
AGENCY_ADMIN_EMAIL=admin@kupuri.com

# Feature Flags
ENABLE_DESIGN_ANALYSIS=true
ENABLE_COMPONENT_GENERATION=true
ENABLE_VIRAL_STRATEGY=true
ENABLE_REAL_TIME_TRENDS=true
ENABLE_ANIMATION_LIBRARY=true
ENABLE_VR_XR=true

# Performance & Optimization
MAX_CONCURRENT_TASKS=10
CACHE_TTL=3600
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# Monitoring & Analytics
ENABLE_SENTRY=false
SENTRY_DSN=
ENABLE_DATADOG=false
DATADOG_API_KEY=

# File Paths
DESIGN_ASSETS_PATH=./assets/designs
TEMPLATES_PATH=./assets/templates
CACHE_PATH=./cache
LOGS_PATH=./logs

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=admin@kupuri.com
